# Copia este archivo como wrangler.toml antes de desplegar el Worker.
name = "elliot-contact-worker"
main = "worker/src/index.ts"
compatibility_date = "2026-05-18"

# Opcion A: usar una ruta en el mismo dominio del sitio.
# Requiere que el registro DNS este proxied en Cloudflare.
routes = [
  { pattern = "elliot-electronics.com/api/contact", zone_name = "elliot-electronics.com" }
]

[vars]
# Puedes enviar a varios correos separandolos por coma:
# TO_EMAIL = "contacto@elliot-electronics.com,otro-correo@ejemplo.com"
TO_EMAIL = "contacto@elliot-electronics.com,eduardovillagomez75@gmail.com,elliot.duran3101@gmail.com"
FROM_EMAIL = "contacto@elliot-electronics.com"
ALLOWED_ORIGIN = "https://elliot-electronics.com"

# El secreto no va en wrangler.toml. Configuralo con:
# npx wrangler secret put RESEND_API_KEY
